#!/usr/bin/env bash
#
# pi-sandbox-whitelist - Manage the host-side whitelist for the Pi sandbox proxy.
#
# Run on the host (requires root to edit /etc/pi-sandbox/whitelist.conf).

set -euo pipefail

WHITELIST_FILE="${PI_SANDBOX_WHITELIST:-/etc/pi-sandbox/whitelist.conf}"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

show_help() {
    cat << EOF
${GREEN}Pi Sandbox Whitelist Manager${NC}

Manages the domain whitelist for the HTTP/HTTPS proxy.

${YELLOW}Usage:${NC}
  $0 add <domain>     Add domain to whitelist (immediate effect)
  $0 remove <domain>  Remove domain from whitelist
  $0 list              List all whitelisted domains
  $0 clear             Remove all domains
  $0 edit              Edit whitelist file in editor
  $0 --help            Show this help

${YELLOW}Whitelist file:${NC}
  $WHITELIST_FILE

${YELLOW}Examples:${NC}
  sudo $0 add ollama.com
  sudo $0 add api.anthropic.com
  sudo $0 list
  sudo $0 remove ollama.com

The proxy reloads the file automatically (within ~2 seconds).
No VM restart is required.
EOF
}

add_domain() {
    local domain="$1"

    if [ -z "$domain" ]; then
        echo -e "${RED}❌ Error: Domain required${NC}" >&2
        exit 1
    fi

    mkdir -p "$(dirname "$WHITELIST_FILE")"

    if [ ! -f "$WHITELIST_FILE" ]; then
        echo "# Pi sandbox whitelist" > "$WHITELIST_FILE"
        echo "# One domain per line" >> "$WHITELIST_FILE"
    fi

    if grep -q "^${domain}$" "$WHITELIST_FILE" 2>/dev/null; then
        echo -e "${YELLOW}⚠️  Domain $domain already in whitelist${NC}"
        return 0
    fi

    echo "$domain" >> "$WHITELIST_FILE"
    echo -e "${GREEN}✅ Added $domain to whitelist${NC}"
    echo "   File: $WHITELIST_FILE"
    echo "   The proxy will detect this change automatically."
}

remove_domain() {
    local domain="$1"

    if [ -z "$domain" ]; then
        echo -e "${RED}❌ Error: Domain required${NC}" >&2
        exit 1
    fi

    if [ ! -f "$WHITELIST_FILE" ]; then
        echo -e "${YELLOW}⚠️  Whitelist file not found${NC}"
        return 0
    fi

    if grep -q "^${domain}$" "$WHITELIST_FILE" 2>/dev/null; then
        grep -v "^${domain}$" "$WHITELIST_FILE" > "${WHITELIST_FILE}.tmp"
        mv "${WHITELIST_FILE}.tmp" "$WHITELIST_FILE"
        echo -e "${GREEN}✅ Removed $domain from whitelist${NC}"
    else
        echo -e "${YELLOW}⚠️  Domain $domain not in whitelist${NC}"
    fi
}

list_domains() {
    echo -e "${GREEN}Pi Sandbox Network Whitelist${NC}"
    echo "=============================="
    echo ""
    echo "File: $WHITELIST_FILE"
    echo ""

    if [ ! -f "$WHITELIST_FILE" ]; then
        echo "  (file does not exist)"
        return 0
    fi

    local count=0
    while IFS= read -r domain; do
        [[ "$domain" =~ ^#.*$ ]] && continue
        [[ -z "$domain" ]] && continue
        echo "  • $domain"
        ((count++))
    done < "$WHITELIST_FILE"

    if [ $count -eq 0 ]; then
        echo "  (none)"
    fi

    echo ""
    echo "Total: $count domain(s)"
}

clear_whitelist() {
    echo -e "${YELLOW}⚠️  This will remove ALL domains from the whitelist.${NC}"
    read -p "Are you sure? (y/N) " confirm

    if [ "$confirm" = "y" ] || [ "$confirm" = "Y" ]; then
        if [ -f "$WHITELIST_FILE" ]; then
            grep "^#" "$WHITELIST_FILE" > "${WHITELIST_FILE}.tmp" 2>/dev/null || {
                echo "# Pi sandbox whitelist" > "${WHITELIST_FILE}.tmp"
                echo "# One domain per line" >> "${WHITELIST_FILE}.tmp"
            }
            mv "${WHITELIST_FILE}.tmp" "$WHITELIST_FILE"
            echo -e "${GREEN}✅ Whitelist cleared${NC}"
        fi
    else
        echo "Cancelled."
    fi
}

edit_whitelist() {
    local editor="${EDITOR:-nano}"
    mkdir -p "$(dirname "$WHITELIST_FILE")"

    if [ ! -f "$WHITELIST_FILE" ]; then
        echo "# Pi sandbox whitelist" > "$WHITELIST_FILE"
        echo "# One domain per line" >> "$WHITELIST_FILE"
    fi

    echo "Opening whitelist file in $editor..."
    $editor "$WHITELIST_FILE"
    echo ""
    echo "The proxy will detect changes automatically."
}

case "${1:-}" in
    add)
        add_domain "$2"
        ;;
    remove)
        remove_domain "$2"
        ;;
    list)
        list_domains
        ;;
    clear)
        clear_whitelist
        ;;
    edit)
        edit_whitelist
        ;;
    --help|-h)
        show_help
        ;;
    *)
        show_help
        exit 1
        ;;
esac
